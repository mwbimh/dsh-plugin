{
  "name": "@dsh-plugins/dsh-quota",
  "description": "Provider-neutral quota snapshot plugin for DeepSeek Harness",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwbimh/dsh-plugin.git",
    "directory": "dsh-quota"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/public.d.ts",
      "default": "./lib/public.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/public.js",
    "lib/types/index.d.ts",
    "lib/types/invariant.d.ts",
    "lib/types/public.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/compatibility.md",
    "docs/security.md",
    "docs/verification.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "vitest run --root .. dsh-quota/tests",
    "test:coverage": "vitest run --root .. --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint --type-aware --tsconfig tsconfig.test.json src tests",
    "build": "tsc -p tsconfig.json && tsdown -c tsdown.config.ts",
    "prepare": "pnpm run build",
    "pack:check": "vitest run --root .. dsh-quota/tests/pack-install.spec.ts",
    "check": "pnpm run test && pnpm run typecheck && pnpm run lint && pnpm run build && pnpm run pack:check"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "vitest": "^4.1.8"
  }
}
