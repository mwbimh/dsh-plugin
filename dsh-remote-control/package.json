{
  "name": "@deepseek-ai/dsh-remote-control",
  "version": "0.1.0",
  "description": "Disabled-by-default, authenticated read-only LAN access for DeepSeek Harness sessions.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "import": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsdown",
    "publint": "publint",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "pack:check": "pnpm run check && pnpm run publint && pnpm pack --pack-destination .artifacts",
    "install:smoke": "pnpm run pack:check && dsh plugin add .artifacts/deepseek-ai-dsh-remote-control-0.1.0.tgz"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "publint": "0.3.21",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
